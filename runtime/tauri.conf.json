{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "webclaw",
  "version": "0.1.18",
  "identifier": "com.webclaw.client",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "中环洁webclaw",
        "width": 1100,
        "height": 820,
        "resizable": true,
        "url": "login/zhj-login.html",
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "fileAssociations": [
      {
        "ext": [
          "webclaw"
        ],
        "name": "Webclaw 自动化任务",
        "description": "Webclaw 浏览器自动化菜谱任务",
        "mimeType": "application/x-webclaw"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "perMachine",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
